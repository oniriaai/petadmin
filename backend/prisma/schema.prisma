generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A customer daycare business. Owns every operational record below.
model Daycare {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  legalName String?
  timezone  String   @default("America/Guayaquil")
  /// Comma-separated business-unit slots this daycare bought, e.g. "DAYCARE,GROOMING".
  units     String   @default("DAYCARE,GROOMING")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  alerts               Alert[]
  checkInOuts          CheckInOut[]
  clients              Client[]
  contracts            Contract[]
  incomes              Income[]
  inventoryItems       InventoryItem[]
  modules              DaycareModule[]
  payables             Payable[]
  pets                 Pet[]
  providers            Provider[]
  recurringPlans       RecurringPlan[]
  reminderMessages     ReminderMessage[]
  reservations         Reservation[]
  rooms                Room[]
  unitSettings         BusinessUnitSetting[]
  users                User[]
  veterinarians        Veterinarian[]
  vetServices          VetService[]
  vetVisits            VetVisit[]
  vetVitals            VetVitals[]
  vetDiagnoses         VetDiagnosis[]
  vetCharges           VetVisitCharge[]
  vetPreventives       VetPreventive[]
  vetPrescriptions     VetPrescription[]
  vetPrescriptionItems VetPrescriptionItem[]
  vetHospitalizations  VetHospitalization[]
  vetTreatmentOrders   VetTreatmentOrder[]
  vetTreatmentDoses    VetTreatmentAdministration[]
  vetProcedures        VetProcedure[]
  vetLabOrders         VetLabOrder[]
  vetLabResultValues   VetLabResultValue[]
  vetConsents          VetConsent[]

  @@map("daycares")
}

/// Per-daycare entitlement for one PRODUCT module id (see platform/product-modules.ts),
/// not a backend module id. Absence of a row means "not enabled".
model DaycareModule {
  id        String   @id @default(cuid())
  daycareId String
  moduleId  String
  isEnabled Boolean  @default(false)
  updatedAt DateTime @updatedAt
  daycare   Daycare  @relation(fields: [daycareId], references: [id], onDelete: Cascade)

  @@unique([daycareId, moduleId])
  @@index([daycareId])
  @@map("daycare_modules")
}

/// Append-only record of vendor-console actions.
model PlatformAuditLog {
  id            String   @id @default(cuid())
  actorUserId   String
  actorUsername String
  action        String
  daycareId     String?
  targetType    String?
  targetId      String?
  detail        String?
  createdAt     DateTime @default(now())

  @@index([daycareId, createdAt])
  @@index([createdAt])
  @@map("platform_audit_logs")
}

model User {
  id            String                       @id @default(cuid())
  daycareId     String?
  /// Unique per daycare, not globally -- see @@unique below and
  /// 20260906000000_per_tenant_usernames for the partial index covering platform accounts.
  username      String
  passwordHash  String
  name          String
  role          String                       @default("owner")
  businessUnit  String
  isActive      Boolean                      @default(true)
  /// Granted permission ids (src/core/tenancy/permissions.ts). Ignored for an admin, which
  /// holds every permission.
  permissions   String[]                     @default([])
  createdAt     DateTime                     @default(now())
  checkInOuts   CheckInOut[]
  veterinarian  Veterinarian?
  vetDosesGiven VetTreatmentAdministration[]

  daycare Daycare? @relation(fields: [daycareId], references: [id], onDelete: Restrict)

  @@unique([daycareId, username])
  @@index([daycareId])
  @@map("users")
}

model Client {
  id               String            @id @default(cuid())
  daycareId        String
  firstName        String
  lastName         String
  idNumber         String?
  phone            String?
  whatsapp         String?
  email            String?
  address          String?
  city             String?
  province         String?
  language         String            @default("es")
  birthdate        DateTime?
  isActive         Boolean           @default(true)
  notes            String?
  firstServiceDate DateTime?
  /// How this tutor wants reminders: WHATSAPP, EMAIL or NONE. Null follows the unit's default.
  reminderChannel  String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  checkInOuts      CheckInOut[]
  contracts        Contract[]
  pets             Pet[]
  recurringPlans   RecurringPlan[]
  reminderMessages ReminderMessage[]
  reservations     Reservation[]
  vetVisits        VetVisit[]
  vetConsents      VetConsent[]

  daycare Daycare @relation(fields: [daycareId], references: [id])

  @@index([daycareId])
  @@map("clients")
}

model Pet {
  id                  String               @id @default(cuid())
  daycareId           String
  clientId            String
  name                String
  species             String               @default("dog")
  breed               String?
  variety             String?
  color               String?
  sex                 String
  birthdate           DateTime?
  weight              Float?
  height              Float?
  microchip           String?
  isNeutered          Boolean              @default(false)
  allergies           String?
  notes               String?
  isActive            Boolean              @default(true)
  bannerId            String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  photoUrl            String?
  bloodType           String?
  chronicConditions   String?
  deceasedAt          DateTime?
  deathCause          String?
  vetVisits           VetVisit[]
  vetVitals           VetVitals[]
  vetDiagnoses        VetDiagnosis[]
  vetPreventives      VetPreventive[]
  vetPrescriptions    VetPrescription[]
  vetHospitalizations VetHospitalization[]
  vetProcedures       VetProcedure[]
  vetLabOrders        VetLabOrder[]
  vetConsents         VetConsent[]
  alerts              Alert[]
  checkInOuts         CheckInOut[]
  contracts           Contract[]
  reminderMessages    ReminderMessage[]
  documents           PetDocument[]
  vaccinations        PetVaccination[]
  client              Client               @relation(fields: [clientId], references: [id])
  reservationPets     ReservationPet[]

  daycare Daycare @relation(fields: [daycareId], references: [id])

  @@index([daycareId])
  @@map("pets")
}

model PetVaccination {
  id             String        @id @default(cuid())
  petId          String
  name           String
  date           DateTime
  nextDue        DateTime?
  notes          String?
  lotNumber      String?
  manufacturer   String?
  /// Set when the vaccine was applied in the clinic rather than transcribed from a card.
  veterinarianId String?
  vetVisitId     String?
  pet            Pet           @relation(fields: [petId], references: [id], onDelete: Cascade)
  veterinarian   Veterinarian? @relation(fields: [veterinarianId], references: [id], onDelete: SetNull)
  vetVisit       VetVisit?     @relation(fields: [vetVisitId], references: [id], onDelete: SetNull)

  @@index([vetVisitId])
  @@map("pet_vaccinations")
}

model PetDocument {
  id         String    @id @default(cuid())
  petId      String
  type       String
  name       String
  filePath   String?
  uploadedAt DateTime  @default(now())
  /// Set when the document was attached from a clinic visit.
  vetVisitId String?
  pet        Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)
  vetVisit   VetVisit? @relation(fields: [vetVisitId], references: [id], onDelete: SetNull)

  @@index([vetVisitId])
  @@map("pet_documents")
}

model Provider {
  id        String    @id @default(cuid())
  daycareId String
  bannerId  String?
  name      String
  idNumber  String?
  email     String?
  phone     String?
  address   String?
  city      String?
  province  String?
  product   String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  payables  Payable[]

  daycare Daycare @relation(fields: [daycareId], references: [id])

  @@index([daycareId])
  @@map("providers")
}

/// A veterinarian known to the daycare: clinic staff, or an external referring vet.
model Veterinarian {
  id            String   @id @default(cuid())
  daycareId     String
  name          String
  phone         String?
  email         String?
  clinic        String?
  licenseNumber String?
  specialty     String?
  /// True for a referring vet who does not attend in this clinic's agenda.
  isExternal    Boolean  @default(false)
  /// The staff account this veterinarian signs in with, if any.
  userId        String?  @unique
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  daycare       Daycare           @relation(fields: [daycareId], references: [id])
  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  visits        VetVisit[]
  vaccinations  PetVaccination[]
  prescriptions VetPrescription[]
  procedures    VetProcedure[]

  @@index([daycareId])
  @@map("veterinarians")
}

/// The clinic's priced service catalogue. Per tenant, because every clinic prices differently.
model VetService {
  id              String   @id @default(cuid())
  daycareId       String
  name            String
  category        String   @default("CONSULTA")
  durationMinutes Int      @default(30)
  basePrice       Float    @default(0)
  description     String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  daycare Daycare          @relation(fields: [daycareId], references: [id])
  charges VetVisitCharge[]

  @@index([daycareId])
  @@map("vet_services")
}

/// The clinical record of one visit. 1:1 with the reservation that holds its slot and billing.
model VetVisit {
  id             String    @id @default(cuid())
  daycareId      String
  reservationId  String    @unique
  petId          String
  clientId       String
  veterinarianId String?
  type           String    @default("CONSULTA")
  triage         String    @default("NORMAL")
  status         String    @default("PROGRAMADA")
  reason         String?
  anamnesis      String?
  physicalExam   String?
  assessment     String?
  plan           String?
  followUpDate   DateTime?
  closedAt       DateTime?
  closedByUserId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  daycare          Daycare              @relation(fields: [daycareId], references: [id])
  reservation      Reservation          @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  pet              Pet                  @relation(fields: [petId], references: [id])
  client           Client               @relation(fields: [clientId], references: [id])
  veterinarian     Veterinarian?        @relation(fields: [veterinarianId], references: [id])
  vitals           VetVitals[]
  diagnoses        VetDiagnosis[]
  charges          VetVisitCharge[]
  documents        PetDocument[]
  vaccinations     PetVaccination[]
  preventives      VetPreventive[]
  prescriptions    VetPrescription[]
  hospitalizations VetHospitalization[]
  procedures       VetProcedure[]
  labOrders        VetLabOrder[]
  consents         VetConsent[]

  @@index([daycareId])
  @@index([daycareId, status])
  @@index([petId])
  @@map("vet_visits")
}

model VetVitals {
  id                String   @id @default(cuid())
  daycareId         String
  petId             String
  visitId           String?
  /// Set when the reading was taken on the ward rather than in the consulting room.
  hospitalizationId String?
  takenAt           DateTime @default(now())
  weightKg          Float?
  temperatureC      Float?
  heartRate         Int?
  respiratoryRate   Int?
  mucousMembranes   String?
  capillaryRefill   String?
  /// Body condition score, 1-9.
  bodyCondition     Int?
  /// Pain score, 0-10.
  painScore         Int?
  notes             String?

  daycare         Daycare             @relation(fields: [daycareId], references: [id])
  pet             Pet                 @relation(fields: [petId], references: [id])
  visit           VetVisit?           @relation(fields: [visitId], references: [id], onDelete: Cascade)
  hospitalization VetHospitalization? @relation(fields: [hospitalizationId], references: [id], onDelete: Cascade)

  @@index([daycareId])
  @@index([petId])
  @@index([visitId])
  @@index([hospitalizationId])
  @@map("vet_vitals")
}

model VetDiagnosis {
  id          String   @id @default(cuid())
  daycareId   String
  visitId     String
  petId       String
  description String
  code        String?
  kind        String   @default("PRESUNTIVO")
  isChronic   Boolean  @default(false)
  createdAt   DateTime @default(now())

  daycare Daycare  @relation(fields: [daycareId], references: [id])
  visit   VetVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  pet     Pet      @relation(fields: [petId], references: [id])

  @@index([daycareId])
  @@index([petId])
  @@index([visitId])
  @@map("vet_diagnoses")
}

/// One billed line of a visit. The sum becomes the reservation's base price when it closes.
model VetVisitCharge {
  id              String   @id @default(cuid())
  daycareId       String
  visitId         String
  vetServiceId    String?
  inventoryItemId String?
  description     String
  quantity        Float    @default(1)
  unitPrice       Float    @default(0)
  createdAt       DateTime @default(now())

  daycare       Daycare        @relation(fields: [daycareId], references: [id])
  visit         VetVisit       @relation(fields: [visitId], references: [id], onDelete: Cascade)
  vetService    VetService?    @relation(fields: [vetServiceId], references: [id], onDelete: SetNull)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  @@index([daycareId])
  @@index([visitId])
  @@map("vet_visit_charges")
}

model Room {
  id               String               @id @default(cuid())
  daycareId        String
  name             String
  businessUnit     String
  capacity         Int                  @default(1)
  type             String               @default("daycare")
  isActive         Boolean              @default(true)
  checkInOuts      CheckInOut[]
  recurringPlans   RecurringPlan[]
  reservations     Reservation[]
  hospitalizations VetHospitalization[]

  daycare Daycare @relation(fields: [daycareId], references: [id])

  @@index([daycareId])
  @@map("rooms")
}

model RecurringPlan {
  id           String        @id @default(cuid())
  daycareId    String
  businessUnit String
  clientId     String
  startDate    DateTime
  endDate      DateTime
  startTime    String
  endTime      String
  daysOfWeek   String
  petIds       String
  service      String        @default("GUARDERIA")
  roomId       String?
  notes        String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  client       Client        @relation(fields: [clientId], references: [id])
  room         Room?         @relation(fields: [roomId], references: [id])
  reservations Reservation[]

  daycare Daycare @relation(fields: [daycareId], references: [id])

  @@index([daycareId])
  @@map("recurring_plans")
}

model BusinessUnitSetting {
  id                     String   @id @default(cuid())
  daycareId              String
  businessUnit           String
  timezone               String
  /// Default VAT applied to new reservations and appointments in this unit.
  vatPercent             Float    @default(15)
  /// Whether the scheduled job sends this unit's reminders. Off until an admin turns it on.
  remindersAuto          Boolean  @default(false)
  /// Channels the unit uses at all: WHATSAPP, EMAIL.
  reminderChannels       String[] @default(["WHATSAPP", "EMAIL"])
  /// The channel of a tutor with no preference of their own.
  reminderDefaultChannel String   @default("WHATSAPP")
  /// Days of notice before a vaccine, a preventive or a follow-up comes due.
  reminderLeadDays       Int      @default(7)
  /// How a tutor reaches the business back; the email is also the Reply-To of a reminder.
  contactPhone           String?
  contactEmail           String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  daycare Daycare @relation(fields: [daycareId], references: [id])

  @@unique([daycareId, businessUnit])
  @@index([daycareId])
  @@map("business_unit_settings")
}

model Reservation {
  id               String           @id @default(cuid())
  daycareId        String
  businessUnit     String
  clientId         String
  roomId           String?
  recurringPlanId  String?
  service          String
  status           String           @default("PENDIENTE")
  checkIn          DateTime?
  checkOut         DateTime?
  needsTransport   Boolean          @default(false)
  transportType    String?
  transportAddress String?
  concept          String?
  notes            String?
  label            String?
  paymentMethod    String?
  discountAmount   Float            @default(0)
  advanceAmount    Float            @default(0)
  basePrice        Float            @default(0)
  vatPercent       Float            @default(15)
  vatAmount        Float            @default(0)
  totalAmount      Float            @default(0)
  pendingAmount    Float            @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  checkInOuts      CheckInOut[]
  incomes          Income[]
  pets             ReservationPet[]
  vetVisit         VetVisit?
  client           Client           @relation(fields: [clientId], references: [id])
  recurringPlan    RecurringPlan?   @relation(fields: [recurringPlanId], references: [id])
  room             Room?            @relation(fields: [roomId], references: [id])
  daycare          Daycare          @relation(fields: [daycareId], references: [id])

  @@unique([recurringPlanId, checkIn])
  @@index([daycareId])
  @@index([daycareId, businessUnit])
  @@map("reservations")
}

model ReservationPet {
  id            String      @id @default(cuid())
  reservationId String
  petId         String
  pet           Pet         @relation(fields: [petId], references: [id])
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@unique([reservationId, petId])
  @@map("reservation_pets")
}

model CheckInOut {
  id                String       @id @default(cuid())
  daycareId         String
  businessUnit      String
  petId             String
  clientId          String
  roomId            String
  reservationId     String?
  checkInTime       DateTime?
  checkOutTime      DateTime?
  performedByUserId String?
  notes             String?
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  client            Client       @relation(fields: [clientId], references: [id])
  performedByUser   User?        @relation(fields: [performedByUserId], references: [id])
  pet               Pet          @relation(fields: [petId], references: [id])
  reservation       Reservation? @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  room              Room         @relation(fields: [roomId], references: [id])
  daycare           Daycare      @relation(fields: [daycareId], references: [id])

  @@index([reservationId])
  @@index([petId])
  @@index([roomId])
  @@index([daycareId, businessUnit])
  @@index([checkInTime])
  @@index([checkOutTime])
  @@index([daycareId])
  @@map("check_in_outs")
}

model Income {
  id            String       @id @default(cuid())
  daycareId     String
  businessUnit  String
  reservationId String?
  type          String       @default("RESERVA")
  concept       String
  amount        Float        @default(0)
  vatPercent    Float        @default(0)
  vatAmount     Float        @default(0)
  total         Float
  paymentMethod String       @default("EFECTIVO")
  invoiceNumber String?
  invoiceStatus String       @default("PENDIENTE")
  date          DateTime     @default(now())
  notes         String?
  createdAt     DateTime     @default(now())
  isActive      Boolean      @default(true)
  reservation   Reservation? @relation(fields: [reservationId], references: [id])

  daycare Daycare @relation(fields: [daycareId], references: [id])

  @@index([daycareId])
  @@index([daycareId, businessUnit])
  @@map("incomes")
}

model Payable {
  id            String    @id @default(cuid())
  daycareId     String
  businessUnit  String
  providerId    String?
  type          String
  category      String
  description   String
  invoiceNumber String?
  invoiceDate   DateTime?
  subtotal      Float
  vatPercent    Float     @default(0)
  vatAmount     Float     @default(0)
  total         Float
  paid          Float     @default(0)
  balance       Float
  status        String    @default("PENDIENTE")
  dueDate       DateTime?
  nextPayment   DateTime?
  isRecurring   Boolean   @default(false)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  provider      Provider? @relation(fields: [providerId], references: [id])
  payments      Payment[]

  daycare Daycare @relation(fields: [daycareId], references: [id])

  @@index([daycareId])
  @@map("payables")
}

model Payment {
  id           String   @id @default(cuid())
  payableId    String
  amount       Float
  date         DateTime @default(now())
  method       String   @default("EFECTIVO")
  reference    String?
  notes        String?
  registeredBy String?
  createdAt    DateTime @default(now())
  payable      Payable  @relation(fields: [payableId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model InventoryItem {
  id                String                @id @default(cuid())
  daycareId         String
  businessUnit      String
  name              String
  category          String
  unit              String                @default("unidad")
  minStock          Float                 @default(0)
  currentStock      Float                 @default(0)
  unitCost          Float                 @default(0)
  isActive          Boolean               @default(true)
  /// A controlled drug: every dispensing is listed in the clinic\'s controlled-substance log.
  isControlled      Boolean               @default(false)
  prescriptionItems VetPrescriptionItem[]
  createdAt         DateTime              @default(now())
  movements         InventoryMovement[]
  vetCharges        VetVisitCharge[]

  daycare Daycare @relation(fields: [daycareId], references: [id])

  @@index([daycareId])
  @@map("inventory_items")
}

model InventoryMovement {
  id                    String               @id @default(cuid())
  itemId                String
  type                  String
  quantity              Float
  cost                  Float?
  reason                String?
  date                  DateTime             @default(now())
  createdAt             DateTime             @default(now())
  lotNumber             String?
  expiresAt             DateTime?
  /// The prescription line this stock was dispensed against, if any.
  vetPrescriptionItemId String?
  item                  InventoryItem        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  vetPrescriptionItem   VetPrescriptionItem? @relation(fields: [vetPrescriptionItemId], references: [id], onDelete: SetNull)

  @@index([itemId])
  @@map("inventory_movements")
}

model Alert {
  id           String    @id @default(cuid())
  daycareId    String
  businessUnit String
  petId        String?
  type         String
  severity     String    @default("MEDIA")
  title        String
  description  String
  isResolved   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  pet          Pet?      @relation(fields: [petId], references: [id])

  daycare Daycare @relation(fields: [daycareId], references: [id])

  @@index([daycareId])
  @@map("alerts")
}

model Contract {
  id           String    @id @default(cuid())
  daycareId    String
  businessUnit String
  clientId     String
  petId        String?
  name         String
  status       String    @default("PENDIENTE_FIRMA")
  startDate    DateTime?
  endDate      DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  client       Client    @relation(fields: [clientId], references: [id])
  pet          Pet?      @relation(fields: [petId], references: [id])

  daycare Daycare @relation(fields: [daycareId], references: [id])

  @@index([daycareId])
  @@map("contracts")
}

/// Deworming and other antiparasitic or preventive treatments, with their next due date.
model VetPreventive {
  id        String    @id @default(cuid())
  daycareId String
  petId     String
  visitId   String?
  kind      String    @default("DESPARASITACION_INTERNA")
  product   String
  dose      String?
  weightKg  Float?
  date      DateTime  @default(now())
  nextDue   DateTime?
  notes     String?
  createdAt DateTime  @default(now())

  daycare Daycare   @relation(fields: [daycareId], references: [id])
  pet     Pet       @relation(fields: [petId], references: [id])
  visit   VetVisit? @relation(fields: [visitId], references: [id], onDelete: SetNull)

  @@index([daycareId])
  @@index([petId])
  @@index([daycareId, nextDue])
  @@map("vet_preventives")
}

model VetPrescription {
  id             String   @id @default(cuid())
  daycareId      String
  visitId        String
  petId          String
  veterinarianId String?
  issuedAt       DateTime @default(now())
  notes          String?

  daycare      Daycare               @relation(fields: [daycareId], references: [id])
  visit        VetVisit              @relation(fields: [visitId], references: [id], onDelete: Cascade)
  pet          Pet                   @relation(fields: [petId], references: [id])
  veterinarian Veterinarian?         @relation(fields: [veterinarianId], references: [id], onDelete: SetNull)
  items        VetPrescriptionItem[]

  @@index([daycareId])
  @@index([petId])
  @@index([visitId])
  @@map("vet_prescriptions")
}

model VetPrescriptionItem {
  id                String    @id @default(cuid())
  daycareId         String
  prescriptionId    String
  drug              String
  presentation      String?
  dose              String
  route             String?
  frequency         String
  durationDays      Int?
  instructions      String?
  /// The stock item this line is dispensed from, when the clinic sells it itself.
  inventoryItemId   String?
  quantityDispensed Float?
  dispensedAt       DateTime?
  dispensedByUserId String?
  lotNumber         String?

  daycare       Daycare             @relation(fields: [daycareId], references: [id])
  prescription  VetPrescription     @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem?      @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  movements     InventoryMovement[]

  @@index([daycareId])
  @@index([prescriptionId])
  @@index([daycareId, dispensedAt])
  @@map("vet_prescription_items")
}

/// An inpatient stay. Opened from a visit, which stays open and carries the bill until discharge.
model VetHospitalization {
  id                   String    @id @default(cuid())
  daycareId            String
  visitId              String
  petId                String
  roomId               String
  status               String    @default("INGRESADO")
  reason               String
  dailyRate            Float     @default(0)
  admittedAt           DateTime  @default(now())
  dischargedAt         DateTime?
  dischargeSummary     String?
  homeCareInstructions String?
  createdAt            DateTime  @default(now())

  daycare Daycare                      @relation(fields: [daycareId], references: [id])
  visit   VetVisit                     @relation(fields: [visitId], references: [id], onDelete: Cascade)
  pet     Pet                          @relation(fields: [petId], references: [id])
  room    Room                         @relation(fields: [roomId], references: [id])
  orders  VetTreatmentOrder[]
  doses   VetTreatmentAdministration[]
  vitals  VetVitals[]

  @@index([daycareId])
  @@index([daycareId, status])
  @@index([petId])
  @@index([visitId])
  @@map("vet_hospitalizations")
}

/// A standing instruction for an inpatient: what to give or do, and how often.
model VetTreatmentOrder {
  id                String    @id @default(cuid())
  daycareId         String
  hospitalizationId String
  description       String
  drug              String?
  dose              String?
  route             String?
  /// Hours between doses. Null for something done once.
  everyHours        Int?
  startAt           DateTime  @default(now())
  endAt             DateTime?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())

  daycare         Daycare                      @relation(fields: [daycareId], references: [id])
  hospitalization VetHospitalization           @relation(fields: [hospitalizationId], references: [id], onDelete: Cascade)
  administrations VetTreatmentAdministration[]

  @@index([daycareId])
  @@index([hospitalizationId])
  @@map("vet_treatment_orders")
}

/// One scheduled dose of an order, given or skipped. Together they are the administration record.
model VetTreatmentAdministration {
  id                   String    @id @default(cuid())
  daycareId            String
  orderId              String
  hospitalizationId    String
  scheduledAt          DateTime
  administeredAt       DateTime?
  administeredByUserId String?
  skippedReason        String?
  notes                String?
  createdAt            DateTime  @default(now())

  daycare         Daycare            @relation(fields: [daycareId], references: [id])
  order           VetTreatmentOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  hospitalization VetHospitalization @relation(fields: [hospitalizationId], references: [id], onDelete: Cascade)
  administeredBy  User?              @relation(fields: [administeredByUserId], references: [id], onDelete: SetNull)

  /// A dose slot is recorded once: two people cannot both sign for the same one.
  @@unique([orderId, scheduledAt])
  @@index([daycareId])
  @@index([hospitalizationId])
  @@map("vet_treatment_administrations")
}

/// A surgery, a minor procedure or a euthanasia performed within a visit.
model VetProcedure {
  id                 String    @id @default(cuid())
  daycareId          String
  visitId            String
  petId              String
  veterinarianId     String?
  name               String
  kind               String    @default("PROCEDIMIENTO")
  status             String    @default("PROGRAMADO")
  /// ASA physical status, 1-5.
  asaRisk            Int?
  anesthesiaProtocol String?
  startAt            DateTime?
  endAt              DateTime?
  findings           String?
  complications      String?
  createdAt          DateTime  @default(now())

  daycare      Daycare       @relation(fields: [daycareId], references: [id])
  visit        VetVisit      @relation(fields: [visitId], references: [id], onDelete: Cascade)
  pet          Pet           @relation(fields: [petId], references: [id])
  veterinarian Veterinarian? @relation(fields: [veterinarianId], references: [id], onDelete: SetNull)

  @@index([daycareId])
  @@index([petId])
  @@index([visitId])
  @@map("vet_procedures")
}

/// A laboratory test or an imaging study requested in a visit, and its result.
model VetLabOrder {
  id             String    @id @default(cuid())
  daycareId      String
  visitId        String
  petId          String
  kind           String    @default("LABORATORIO")
  test           String
  externalLab    String?
  status         String    @default("SOLICITADO")
  notes          String?
  requestedAt    DateTime  @default(now())
  resultSummary  String?
  resultFilePath String?
  resultAt       DateTime?

  daycare Daycare             @relation(fields: [daycareId], references: [id])
  visit   VetVisit            @relation(fields: [visitId], references: [id], onDelete: Cascade)
  pet     Pet                 @relation(fields: [petId], references: [id])
  values  VetLabResultValue[]

  @@index([daycareId])
  @@index([daycareId, status])
  @@index([petId])
  @@index([visitId])
  @@map("vet_lab_orders")
}

model VetLabResultValue {
  id             String  @id @default(cuid())
  daycareId      String
  orderId        String
  analyte        String
  value          String
  unit           String?
  referenceRange String?
  flag           String?

  daycare Daycare     @relation(fields: [daycareId], references: [id])
  order   VetLabOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([daycareId])
  @@index([orderId])
  @@map("vet_lab_result_values")
}

/// The tutor's informed consent for a surgery, anaesthesia, admission or euthanasia.
model VetConsent {
  id           String    @id @default(cuid())
  daycareId    String
  petId        String
  clientId     String
  visitId      String?
  type         String
  text         String
  signedByName String?
  signedAt     DateTime?
  filePath     String?
  createdAt    DateTime  @default(now())

  daycare Daycare   @relation(fields: [daycareId], references: [id])
  pet     Pet       @relation(fields: [petId], references: [id])
  client  Client    @relation(fields: [clientId], references: [id])
  visit   VetVisit? @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([daycareId])
  @@index([petId])
  @@index([visitId])
  @@map("vet_consents")
}

/// One reminder the system sent, tried to send or decided not to send to a tutor.
model ReminderMessage {
  id                String    @id @default(cuid())
  daycareId         String
  businessUnit      String
  /// Nullable so the log outlives the record it was about; `recipient` is the snapshot.
  clientId          String?
  petId             String?
  /// CITA, VACUNA, PREVENTIVO, CONTROL or LABORATORIO.
  kind              String
  /// What the reminder is about, e.g. "CITA:<reservationId>" or "VACUNA:<vaccinationId>".
  sourceKey         String
  /// Set on automatic sends only, where it is what makes a second run a no-op.
  dedupeKey         String?
  /// WHATSAPP or EMAIL. Null when nothing was sent because no channel applied.
  channel           String?
  recipient         String?
  /// PENDIENTE, ENVIADO, FALLIDO or OMITIDO.
  status            String    @default("PENDIENTE")
  /// AUTO or MANUAL.
  trigger           String    @default("AUTO")
  attempts          Int       @default(0)
  providerMessageId String?
  error             String?
  sentByUserId      String?
  createdAt         DateTime  @default(now())
  sentAt            DateTime?

  daycare Daycare @relation(fields: [daycareId], references: [id])
  client  Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  pet     Pet?    @relation(fields: [petId], references: [id], onDelete: SetNull)

  @@unique([daycareId, dedupeKey])
  @@index([daycareId, createdAt])
  @@index([daycareId, sourceKey])
  @@map("reminder_messages")
}
