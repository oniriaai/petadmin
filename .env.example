# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
POSTGRES_DB=argos
POSTGRES_USER=argos
POSTGRES_PASSWORD=argos123
DATABASE_URL=postgresql://argos:argos123@postgres:5432/argos

BACKEND_PORT=3001
FRONTEND_PORT=5174

# IVA por defecto cuando una unidad de negocio no define el suyo.
VAT_PERCENT=21

# ---------------------------------------------------------------------------
# Cuenta de plataforma (el proveedor). daycareId nulo: no pertenece a ninguna
# guardería. SUPERADMIN_PASSWORD es obligatorio cuando NODE_ENV=production.
# ---------------------------------------------------------------------------
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=superadmin123
SUPERADMIN_NAME=Plataforma

# ---------------------------------------------------------------------------
# Seguridad
# ---------------------------------------------------------------------------
# Clave de firma de los JWT. En producción el backend NO arranca si falta, si
# conserva el valor de ejemplo, o si tiene menos de 32 caracteres: con una clave
# conocida cualquiera puede emitirse un token de superadmin.
#   Generar:  openssl rand -base64 48
JWT_SECRET=dev_only_insecure_secret_change_me

# Orígenes del frontend autorizados, separados por comas. Obligatorio en
# producción; sin definir, en desarrollo se permite el servidor de Vite.
#   CORS_ORIGINS=https://admin.tudominio.com
CORS_ORIGINS=

# Detrás de un proxy inverso, cuántos saltos confiar para resolver la IP real
# (habitualmente 1). Sin definir, Express no confía en X-Forwarded-For y todos
# los límites por IP compartirían un único contador.
TRUST_PROXY=

# Límites de peticiones (opcionales; estos son los valores por defecto).
RATE_LIMIT_GLOBAL=600
RATE_LIMIT_LOGIN=10
RATE_LIMIT_STORAGE=60

# ---------------------------------------------------------------------------
# Observabilidad
# ---------------------------------------------------------------------------
# Nivel de registro: por defecto "debug" fuera de producción, "info" en producción.
LOG_LEVEL=

# Reporte de errores. Sin definir, no se envía nada a ninguna parte; definido, los
# errores se reportan etiquetados por inquilino.
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Datos de ejemplo
# ---------------------------------------------------------------------------
# Crea las guarderías de demostración (principal, demo) con contraseñas conocidas.
# Necesario para las suites e2e; NUNCA debe activarse contra datos de clientes.
# Sin definir: activo fuera de producción, inactivo en producción.
SEED_DEMO_DATA=

# Reconstruye la guardería de demostración principal cuando sus datos son de un día anterior:
# todo en ella está fechado respecto al día en que se sembró, así que sin esto una demo pública
# muestra un "hoy" vacío a partir del segundo día. Único valor reconocido: daily. Se ignora si
# SEED_DEMO_DATA no está activo.
# NUNCA ACTIVAR SOBRE DATOS DE CLIENTES: además de `daycare_principal` borra todas las filas de
# `daycare_pethijos` (el id anterior de la demo), que en algunas instalaciones es el negocio real.
SEED_DEMO_RESET=

# Ejecuta el generador de planes recurrentes dentro del proceso web. Sin definir:
# activo fuera de producción. En producción se ejecuta como job programado.
RUN_SCHEDULER_IN_PROCESS=

# ---------------------------------------------------------------------------
# Copias de seguridad (scripts/backup.sh)
# ---------------------------------------------------------------------------
# Directorio de los volcados y días que se conservan antes de rotarlos.
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14

# ---------------------------------------------------------------------------
# Almacenamiento Backblaze B2
# ---------------------------------------------------------------------------
B2_KEY_ID=tu_key_id
B2_APPLICATION_KEY=tu_application_key
B2_BUCKET_NAME=nombre_del_bucket
B2_ENDPOINT=s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005

# ---------------------------------------------------------------------------
# Solo producción (docker-compose.prod.yml)
# ---------------------------------------------------------------------------
# URL pública de la API, incrustada en el build del frontend.
#
# En producción esto NO se lee de aquí: el frontend se construye en el workflow de release,
# que la toma de la variable de repositorio PUBLIC_API_URL en GitHub. Esta entrada sirve para
# construir las imágenes a mano con `up --build`.
PUBLIC_API_URL=https://api.tudominio.com/api/v1

# Etiqueta de la release publicada que corre este host. Sin definir se usa `latest`, que es
# cómodo pero no es trazable: fíjala a la etiqueta exacta (v1.2.3) para saber qué está en
# producción y para poder revertir apuntándola a la anterior.
#   APP_VERSION=v1.2.3
APP_VERSION=
